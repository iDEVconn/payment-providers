+                expectedVersion: unit.version,
+                unitStatus: 'failed',
+              }),
+            ),
+            PAYMENT_RELIABILITY_ERROR.TRANSITION_CONFLICT,
+          );
+          expect(
+            (await marketplaceStore.findMarketplacePurchaseUnitByCaptureId(captureId))?.unitId,
+          ).toBe(unit.unitId);
+        });
+      });
+    }
+  });

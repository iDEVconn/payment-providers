+
+    describe('candidate ordering', () => {
+      it('listReconciliationCandidates returns verified unmatched evidence oldest first', async (store, ctx) => {
+        const ids: string[] = [];
+        for (let index = 0; index < 3; index += 1) {
+          ids.push(
+            (
+              await insertEvidenceIn(store, ctx, {
+                verificationStatus: 'verified',
+                processingStatus: 'unmatched',
+              })
+            ).evidenceId,
+          );
+          await pause(gapMs);
+        }
+        await insertEvidenceIn(store, ctx, { processingStatus: 'unmatched' });
+        expect((await store.listReconciliationCandidates(10)).map((row) => row.evidenceId)).toEqual(
+          ids,
+        );
+        expect((await store.listReconciliationCandidates(2)).map((row) => row.evidenceId)).toEqual(
+          ids.slice(0, 2),
+        );
+      });
+
+      it('listUncertainOperations returns unknown operations oldest first (by createdAt)', async (store, ctx) => {
+        const created: PaymentOperation[] = [];
+        for (let index = 0; index < 3; index += 1) {
+          created.push(await createOperation(store, ctx));
+          await pause(gapMs);
+        }
+        await createOperation(store, ctx);
+        for (const operation of [...created].reverse()) {
+          await toUnknown(store, operation);
+          await pause(gapMs);
+        }
+        const ids = created.map((operation) => operation.operationId);
+        expect((await store.listUncertainOperations(10)).map((row) => row.operationId)).toEqual(
+          ids,
+        );
+        expect((await store.listUncertainOperations(2)).map((row) => row.operationId)).toEqual(
+          ids.slice(0, 2),

diff --color -ruN .superpowers/snap-after-t6a/src/core/lib/__tests__/stale-submitted-operations.unit.test.ts .superpowers/snap-after-t6b/src/core/lib/__tests__/stale-submitted-operations.unit.test.ts
--- .superpowers/snap-after-t6a/src/core/lib/__tests__/stale-submitted-operations.unit.test.ts	1970-01-01 02:00:00.000000000 +0200

+    let error: unknown;
+    try {
+      new ReconciliationService(store, lookup, {}, options);
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).toBeInstanceOf(PaymentConfigurationError);
+    expect((error as PaymentConfigurationError).missingFields).toEqual([field]);
+  });
+
+  it.each([

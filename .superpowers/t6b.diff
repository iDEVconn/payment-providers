+async function evidenceOf(store: MemoryPaymentReliabilityStore, evidenceId: string) {
+  const row = await store.findEvidenceById(evidenceId);
+  if (!row) {
+    throw new Error(`missing evidence ${evidenceId}`);
+  }
+  return row;
+}

+    [{ retryBaseDelayMs: 2_000, retryMaxDelayMs: 1_000 }, 'retryMaxDelayMs'],
+    [{ maxAttempts: 0 }, 'maxAttempts'],
+    [{ maxAttempts: 2.5 }, 'maxAttempts'],
+    [{ submittedStaleAfterMs: 0 }, 'submittedStaleAfterMs'],

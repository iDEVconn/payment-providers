+import { describe, expect, it } from 'vitest';
+import {
+  currencyMinorUnitExponent,
+  parseDecimalToMinorUnits,
+} from '../subscription-money';
+
+describe('currencyMinorUnitExponent', () => {
+  it.each([
+    ['USD', 2],
+    ['eur', 2],
+    ['JPY', 0],
+    ['KRW', 0],
+    ['VND', 0],
+    ['BHD', 3],
+    ['KWD', 3],
+    ['JOD', 3],
+    ['OMR', 3],
+    ['TND', 3],
+    ['XYZ', 2],
+  ])('%s -> %i', (currency, exponent) => {
+    expect(currencyMinorUnitExponent(currency)).toBe(exponent);
+  });
+});
+
+describe('parseDecimalToMinorUnits', () => {
+  it.each([
+    ['10.00', 'USD', '1000'],
+    ['10', 'USD', '1000'],
+    ['10.5', 'USD', '1050'],
+    ['0.01', 'USD', '1'],
+    ['0', 'USD', '0'],
+    ['000123.40', 'USD', '12340'],
+    ['1000', 'JPY', '1000'],
+    ['1000.00', 'JPY', '1000'],
+    ['1.234', 'KWD', '1234'],
+    ['1.2', 'BHD', '1200'],
+    ['10.000', 'USD', '1000'],
+    // A value well past Number.MAX_SAFE_INTEGER stays exact (no floating point).
+    ['123456789012345678.99', 'USD', '12345678901234567899'],
+  ])('%s %s -> %s', (value, currency, expected) => {
+    expect(parseDecimalToMinorUnits(value, currency)).toBe(expected);
+  });
+
+  it.each([
+    ['0.01', 'JPY'],
+    ['10.001', 'USD'],
+    ['-1.00', 'USD'],
+    ['1e3', 'USD'],
+    ['1,000.00', 'USD'],
+    ['', 'USD'],
+    [' 1.00', 'USD'],
+    ['.5', 'USD'],
+    ['5.', 'USD'],
+    ['10.00', 'US'],
+    ['10.00', 'US1'],
+    ['1'.repeat(40), 'USD'],
+  ])('rejects %j %j', (value, currency) => {
+    expect(parseDecimalToMinorUnits(value, currency)).toBeNull();
+  });
+
+  it('rejects non-string input instead of converting through a float', () => {
+    expect(parseDecimalToMinorUnits(10.1 as unknown as string, 'USD')).toBeNull();
+    expect(parseDecimalToMinorUnits(null as unknown as string, 'USD')).toBeNull();
+    expect(parseDecimalToMinorUnits('1.00', 5 as unknown as string)).toBeNull();
+  });
+});
diff --git a/src/subscription-core/lib/normalize-paypal-subscription-event.ts b/src/subscription-core/lib/normalize-paypal-subscription-event.ts
new file mode 100644
index 0000000..0436125
--- /dev/null
+++ b/src/subscription-core/lib/normalize-paypal-subscription-event.ts
@@ -0,0 +1,274 @@
+import type { SubscriptionStatus } from '../../contracts/lib/subscription';
+import {
+  SUBSCRIPTION_LOOKUP_EVENT_TYPE,
+  type NormalizeSubscriptionEventResult,
+  type NormalizedSubscriptionEvent,
+  type SubscriptionLastPayment,
+  type SubscriptionMoney,
+  type SubscriptionSalePayment,
+} from './subscription-core-types';
+import { normalizeCurrencyCode, parseDecimalToMinorUnits } from './subscription-money';
+import {
+  SUBSCRIPTION_PAYMENT_FAILED_EVENT_TYPE,
+  SUBSCRIPTION_SALE_EVENT_TYPES,
+  mapPaypalSubscriptionStatus,
+  mapSubscriptionWebhookEventToStatus,
+  parseProviderTimestamp,
+} from './subscription-status-rules';
+
+export { isFreshTransmission } from './subscription-status-rules';
+
+type JsonObject = Record<string, unknown>;
+
+/** PayPal ids are printable ASCII without spaces (`WH-…`, `I-…`, `P-…`). */
+const PROVIDER_ID_PATTERN = /^[\x21-\x7e]{1,128}$/;
+const MAX_STATUS_LENGTH = 64;
+
+const SUBSCRIPTION_EVENT_TYPES: ReadonlySet<string> = new Set([
+  'BILLING.SUBSCRIPTION.CREATED',
+  'BILLING.SUBSCRIPTION.APPROVED',
+  'BILLING.SUBSCRIPTION.ACTIVATED',
+  'BILLING.SUBSCRIPTION.RE-ACTIVATED',
+  'BILLING.SUBSCRIPTION.UPDATED',
+  'BILLING.SUBSCRIPTION.SUSPENDED',
+  'BILLING.SUBSCRIPTION.CANCELLED',
+  'BILLING.SUBSCRIPTION.EXPIRED',
+  SUBSCRIPTION_PAYMENT_FAILED_EVENT_TYPE,
+]);
+
+const SALE_EVENT_TYPES: ReadonlySet<string> = new Set(SUBSCRIPTION_SALE_EVENT_TYPES);
+
+function isObject(value: unknown): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** Own property only, so `__proto__` / inherited keys never leak in. */
+function own(source: unknown, key: string): unknown {
+  if (!isObject(source) || !Object.prototype.hasOwnProperty.call(source, key)) {
+    return undefined;
+  }
+  return source[key];
+}
+
+function readId(value: unknown): string | null {
+  return typeof value === 'string' && PROVIDER_ID_PATTERN.test(value) ? value : null;
+}
+
+function readCount(value: unknown): number | null {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 ? value : null;
+}
+
+/** `{ currency_code, value }` (v2 shape) or `{ currency, total }` (v1 sale shape). */
+function readMoneyParts(value: unknown): { amountMinor: string | null; currency: string | null } | null {
+  if (!isObject(value)) {
+    return null;
+  }
+  const currency = normalizeCurrencyCode(own(value, 'currency_code') ?? own(value, 'currency'));
+  const amount = own(value, 'value') ?? own(value, 'total');
+  const amountMinor =
+    currency !== null && typeof amount === 'string' ? parseDecimalToMinorUnits(amount, currency) : null;
+  return { amountMinor, currency };
+}
+
+function readMoney(value: unknown): SubscriptionMoney | null {
+  const parts = readMoneyParts(value);
+  if (!parts || parts.amountMinor === null || parts.currency === null) {
+    return null;
+  }
+  return { amountMinor: parts.amountMinor, currency: parts.currency };
+}
+
+function readLastPayment(value: unknown): SubscriptionLastPayment | null {
+  const money = readMoney(own(value, 'amount'));
+  if (!money) {
+    return null;
+  }
+  return { ...money, time: parseProviderTimestamp(own(value, 'time')) };
+}
+
+function readStateAt(resource: JsonObject): string | null {
+  // `update_time ?? create_time`, as the engine's watermark has always read it.
+  const candidate = own(resource, 'update_time') ?? own(resource, 'create_time');
+  return parseProviderTimestamp(candidate);
+}
+
+function readProviderStatus(resource: JsonObject): string | null {
+  const status = own(resource, 'status');
+  return typeof status === 'string' && status.length > 0 && status.length <= MAX_STATUS_LENGTH
+    ? status
+    : null;
+}
+
+function statusFromResource(providerStatus: string | null): SubscriptionStatus | null {
+  if (!providerStatus) {
+    return null;
+  }
+  const mapped = mapPaypalSubscriptionStatus(providerStatus);
+  return mapped === 'unknown' ? null : mapped;
+}
+
+function parseJsonObject(rawBody: unknown): JsonObject | 'invalid_json' | 'not_an_object' {
+  if (typeof rawBody !== 'string' || rawBody.length === 0) {
+    return 'invalid_json';
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(rawBody);
+  } catch {
+    return 'invalid_json';
+  }
+  return isObject(parsed) ? parsed : 'not_an_object';
+}
+
+function subscriptionResourceFields(resource: JsonObject) {
+  const billingInfo = own(resource, 'billing_info');
+  return {
+    providerPlanId: readId(own(resource, 'plan_id')),
+    providerStatus: readProviderStatus(resource),
+    stateAt: readStateAt(resource),
+    nextBillingTime: parseProviderTimestamp(own(billingInfo, 'next_billing_time')),
+    startTime: parseProviderTimestamp(own(resource, 'start_time')),
+    lastPayment: readLastPayment(own(billingInfo, 'last_payment')),
+    failedPaymentsCount: readCount(own(billingInfo, 'failed_payments_count')),
+    outstandingBalance: readMoney(own(billingInfo, 'outstanding_balance')),
+  };
+}
+
+function normalizeOrThrow(rawBody: string): NormalizeSubscriptionEventResult {
+  const body = parseJsonObject(rawBody);
+  if (typeof body === 'string') {
+    return { ok: false, reason: body };
+  }
+
+  const providerEventId = readId(own(body, 'id'));
+  if (!providerEventId) {
+    return { ok: false, reason: 'missing_event_id' };
+  }
+  const eventType = own(body, 'event_type');
+  if (typeof eventType !== 'string' || eventType.length === 0) {
+    return { ok: false, reason: 'missing_event_type' };
+  }
+  const isSale = SALE_EVENT_TYPES.has(eventType);
+  if (!isSale && !SUBSCRIPTION_EVENT_TYPES.has(eventType)) {
+    return { ok: false, reason: 'unsupported_event_type' };
+  }
+  const resource = own(body, 'resource');
+  if (!isObject(resource)) {
+    return { ok: false, reason: 'missing_resource' };
+  }
+  const eventTime = parseProviderTimestamp(own(body, 'create_time'));
+
+  if (isSale) {
+    const providerSubscriptionId = readId(own(resource, 'billing_agreement_id'));
+    if (!providerSubscriptionId) {
+      return { ok: false, reason: 'missing_subscription_id' };
+    }
+    const money = readMoneyParts(own(resource, 'amount'));
+    const payment: SubscriptionSalePayment = {
+      amountMinor: money?.amountMinor ?? null,
+      currency: money?.currency ?? null,
+      saleId:
+        eventType === 'PAYMENT.SALE.COMPLETED'
+          ? readId(own(resource, 'id'))
+          : (readId(own(resource, 'sale_id')) ?? readId(own(resource, 'id'))),
+    };
+    return {
+      ok: true,
+      event: {
+        providerEventId,
+        eventType,
+        resourceType: 'sale',
+        providerSubscriptionId,
+        providerPlanId: null,
+        providerStatus: null,
+        subscriptionStatus: null,
+        stateAt: readStateAt(resource),
+        nextBillingTime: null,
+        startTime: null,
+        lastPayment: null,
+        failedPaymentsCount: null,
+        outstandingBalance: null,
+        payment,
+        eventTime,
+      },
+    };
+  }
+
+  const providerSubscriptionId = readId(own(resource, 'id'));
+  if (!providerSubscriptionId) {
+    return { ok: false, reason: 'missing_subscription_id' };
+  }
+  const fields = subscriptionResourceFields(resource);
+  const subscriptionStatus =
+    eventType === SUBSCRIPTION_PAYMENT_FAILED_EVENT_TYPE
+      ? null
+      : (mapSubscriptionWebhookEventToStatus(eventType) ?? statusFromResource(fields.providerStatus));
+  return {
+    ok: true,
+    event: {
+      providerEventId,
+      eventType,
+      resourceType: 'subscription',
+      providerSubscriptionId,
+      ...fields,
+      subscriptionStatus,
+      payment: null,
+      eventTime,
+    },
+  };
+}
+
+/**
+ * Normalise a PayPal subscription or subscription-sale webhook body. Never
+ * throws: invalid JSON, a wrong shape or an event that is not about a
+ * subscription gives `ok: false`. Invalid optional fields become null.
+ */
+export function normalizePaypalSubscriptionEvent(rawBody: string): NormalizeSubscriptionEventResult {
+  try {
+    return normalizeOrThrow(rawBody);
+  } catch {
+    return { ok: false, reason: 'invalid_json' };
+  }
+}
+
+/**
+ * Normalise a PayPal `GET /v1/billing/subscriptions/{id}` response body into
+ * the same event shape (`eventType` = `SUBSCRIPTION_LOOKUP_EVENT_TYPE`,
+ * `providerEventId` = null), for `reduceSubscription(..., { source: 'lookup' })`.
+ */
+export function normalizePaypalSubscriptionResource(rawBody: string): NormalizeSubscriptionEventResult {
+  try {
+    const resource = parseJsonObject(rawBody);
+    if (typeof resource === 'string') {
+      return { ok: false, reason: resource };
+    }
+    const providerSubscriptionId = readId(own(resource, 'id'));
+    if (!providerSubscriptionId) {
+      return { ok: false, reason: 'missing_subscription_id' };
+    }
+    const fields = subscriptionResourceFields(resource);
+    const event: NormalizedSubscriptionEvent = {
+      providerEventId: null,
+      eventType: SUBSCRIPTION_LOOKUP_EVENT_TYPE,
+      resourceType: 'subscription',
+      providerSubscriptionId,
+      ...fields,
+      subscriptionStatus: statusFromResource(fields.providerStatus),
+      payment: null,
+      eventTime: null,
+    };
+    return { ok: true, event };
+  } catch {
+    return { ok: false, reason: 'invalid_json' };
+  }
+}
+
+/** The webhook body `id`, or null when absent or not a valid provider id. Never throws. */
+export function deriveProviderEventId(rawBody: string): string | null {
+  try {
+    const body = parseJsonObject(rawBody);
+    return typeof body === 'string' ? null : readId(own(body, 'id'));
+  } catch {
+    return null;
+  }
+}
diff --git a/src/subscription-core/lib/reduce-subscription.ts b/src/subscription-core/lib/reduce-subscription.ts
new file mode 100644
index 0000000..162a0ed
--- /dev/null
+++ b/src/subscription-core/lib/reduce-subscription.ts
@@ -0,0 +1,249 @@
+import {
+  type NormalizedSubscriptionEvent,
+  type ReduceSubscriptionNoopReason,
+  type ReduceSubscriptionOptions,
+  type ReduceSubscriptionResult,
+  type SubscriptionEffect,
+  type SubscriptionMoney,
+  type SubscriptionState,
+} from './subscription-core-types';
+import { compareMinorUnits, isMinorUnitString, normalizeCurrencyCode } from './subscription-money';
+import {
+  SUBSCRIPTION_PAYMENT_FAILED_EVENT_TYPE,
+  compareProviderStateTimestamps,
+  evaluateSubscriptionStateOrdering,
+  resolveSubscriptionStatusTransition,
+} from './subscription-status-rules';
+
+export type {
+  ReduceSubscriptionOptions,
+  ReduceSubscriptionResult,
+  SubscriptionState,
+} from './subscription-core-types';
+
+export function initialSubscriptionState(overrides: Partial<SubscriptionState> = {}): SubscriptionState {
+  return {
+    status: 'approval_pending',
+    providerSubscriptionId: null,
+    providerPlanId: null,
+    stateAt: null,
+    nextBillingTime: null,
+    startTime: null,
+    lastPayment: null,
+    failedPaymentsCount: null,
+    lastEventId: null,
+    ...overrides,
+  };
+}
+
+function noop(
+  state: SubscriptionState,
+  reason: ReduceSubscriptionNoopReason,
+  effects: SubscriptionEffect[] = [],
+): ReduceSubscriptionResult {
+  return { state, decision: 'noop', reason, effects };
+}
+
+function applied(state: SubscriptionState, effects: SubscriptionEffect[]): ReduceSubscriptionResult {
+  return { state, decision: 'applied', effects };
+}
+
+/** True when `candidate` is not older than `current` (null times never win over a known time). */
+function isNotOlder(candidate: string | null, current: string | null): boolean {
+  if (!current) {
+    return true;
+  }
+  if (!candidate) {
+    return false;
+  }
+  return compareProviderStateTimestamps(current, candidate) !== 'older';
+}
+
+function reduceSale(
+  state: SubscriptionState,
+  event: NormalizedSubscriptionEvent,
+  options: ReduceSubscriptionOptions,
+): ReduceSubscriptionResult {
+  const payment = event.payment ?? { amountMinor: null, currency: null, saleId: null };
+  const withEventId = { ...state, lastEventId: event.providerEventId ?? state.lastEventId };
+
+  if (event.eventType !== 'PAYMENT.SALE.COMPLETED') {
+    return applied(withEventId, [
+      {
+        type: 'refund_or_reversal',
+        eventType: event.eventType,
+        amountMinor: payment.amountMinor,
+        currency: payment.currency,
+        saleId: payment.saleId,
+      },
+    ]);
+  }
+
+  const expected = options.expectedPayment ?? null;
+  const expectedCurrency = expected ? normalizeCurrencyCode(expected.currency) : null;
+  if (expectedCurrency && payment.currency !== expectedCurrency) {
+    return noop(state, 'currency_mismatch', [
+      {
+        type: 'currency_mismatch',
+        expectedCurrency,
+        actualCurrency: payment.currency,
+        saleId: payment.saleId,
+      },
+    ]);
+  }
+  // A malformed expected price fails closed, as does an amount that cannot be represented.
+  if (
+    payment.amountMinor === null ||
+    payment.currency === null ||
+    (expected !== null &&
+      (!expectedCurrency ||
+        !isMinorUnitString(expected.amountMinor) ||
+        compareMinorUnits(payment.amountMinor, expected.amountMinor) < 0))
+  ) {
+    const expectedMoney: SubscriptionMoney | null = expected
+      ? { amountMinor: expected.amountMinor, currency: expectedCurrency ?? expected.currency }
+      : null;
+    return noop(state, 'amount_mismatch', [
+      {
+        type: 'amount_mismatch',
+        expected: expectedMoney,
+        actual: { amountMinor: payment.amountMinor, currency: payment.currency },
+        saleId: payment.saleId,
+      },
+    ]);
+  }
+
+  const time = event.stateAt ?? event.eventTime;
+  const lastPayment = isNotOlder(time, state.lastPayment?.time ?? null)
+    ? { amountMinor: payment.amountMinor, currency: payment.currency, time }
+    : state.lastPayment;
+  return applied({ ...withEventId, lastPayment }, [
+    {
+      type: 'payment_completed',
+      amountMinor: payment.amountMinor,
+      currency: payment.currency,
+      saleId: payment.saleId,
+      time,
+    },
+  ]);
+}
+
+function reducePaymentFailed(
+  state: SubscriptionState,
+  event: NormalizedSubscriptionEvent,
+): ReduceSubscriptionResult {
+  const failedPaymentsCount = event.failedPaymentsCount ?? (state.failedPaymentsCount ?? 0) + 1;
+  return applied(
+    {
+      ...state,
+      failedPaymentsCount,
+      lastEventId: event.providerEventId ?? state.lastEventId,
+    },
+    [{ type: 'payment_failed', failedPaymentsCount, outstandingBalance: event.outstandingBalance }],
+  );
+}
+
+function reduceSubscriptionResource(
+  state: SubscriptionState,
+  event: NormalizedSubscriptionEvent,
+  options: ReduceSubscriptionOptions,
+): ReduceSubscriptionResult {
+  const desired =
+    event.subscriptionStatus && event.subscriptionStatus !== 'unknown'
+      ? event.subscriptionStatus
+      : state.status;
+  const resolved = resolveSubscriptionStatusTransition(state.status, desired);
+  const isLookup = options.source === 'lookup';
+
+  const ordering = evaluateSubscriptionStateOrdering({
+    currentStatus: state.status,
+    storedStateAt: state.stateAt,
+    desiredStatus: resolved,
+    incomingStateAt: event.stateAt,
+    authoritative: isLookup,
+  });
+  if (ordering.action === 'noop') {
+    return noop(state, ordering.reason);
+  }
+  if (resolved !== desired) {
+    return noop(state, 'transition_rejected');
+  }
+
+  // A lookup never moves the watermark back; a webhook moves it to its own time.
+  const stateAt = isLookup
+    ? event.stateAt && isNotOlder(event.stateAt, state.stateAt)
+      ? event.stateAt
+      : state.stateAt
+    : (ordering.stateAt ?? state.stateAt);
+
+  const nextBillingTime = event.nextBillingTime ?? state.nextBillingTime;
+  const startTime = event.startTime ?? state.startTime;
+  const lastPayment =
+    event.lastPayment && isNotOlder(event.lastPayment.time, state.lastPayment?.time ?? null)
+      ? event.lastPayment
+      : state.lastPayment;
+
+  const next: SubscriptionState = {
+    ...state,
+    status: resolved,
+    providerPlanId: event.providerPlanId ?? state.providerPlanId,
+    stateAt,
+    nextBillingTime,
+    startTime,
+    lastPayment,
+    failedPaymentsCount: event.failedPaymentsCount ?? state.failedPaymentsCount,
+    lastEventId: event.providerEventId ?? state.lastEventId,
+  };
+
+  const effects: SubscriptionEffect[] = [];
+  if (resolved !== state.status) {
+    effects.push({ type: 'status_changed', from: state.status, to: resolved });
+  }
+  if (nextBillingTime !== state.nextBillingTime || startTime !== state.startTime) {
+    effects.push({ type: 'period_updated', nextBillingTime, startTime });
+  }
+  return applied(next, effects);
+}
+
+/**
+ * Pure subscription reducer: given the stored state and one normalised event,
+ * return the next state, whether the event applied, and plain-data effects the
+ * host maps to its own business hooks. Never mutates `state`; a noop returns
+ * the same `state` object.
+ *
+ * Rules: terminal `cancelled|expired` never move; nothing past approval moves
+ * back to `approval_pending`; for webhooks an older `stateAt` is a noop, an
+ * equal `stateAt` with a conflicting status is a noop, and a missing `stateAt`
+ * after a watermark is a noop; a `lookup` is authoritative over ordering. An
+ * event plan id that differs from `expectedPlanId` (default: the stored plan)
+ * is reported and not applied. A completed sale in another currency or below
+ * `expectedPayment` is reported and not applied. Payment events never change
+ * the status or the watermark.
+ */
+export function reduceSubscription(
+  state: SubscriptionState,
+  event: NormalizedSubscriptionEvent,
+  options: ReduceSubscriptionOptions,
+): ReduceSubscriptionResult {
+  if (event.providerEventId !== null && event.providerEventId === state.lastEventId) {
+    return noop(state, 'duplicate_event');
+  }
+  if (state.providerSubscriptionId && event.providerSubscriptionId !== state.providerSubscriptionId) {
+    return noop(state, 'subscription_mismatch');
+  }
+
+  const expectedPlanId = options.expectedPlanId ?? state.providerPlanId;
+  if (expectedPlanId && event.providerPlanId && event.providerPlanId !== expectedPlanId) {
+    return noop(state, 'plan_mismatch', [
+      { type: 'plan_mismatch', expectedPlanId, actualPlanId: event.providerPlanId },
+    ]);
+  }
+
+  if (event.resourceType === 'sale') {
+    return reduceSale(state, event, options);
+  }
+  if (event.eventType === SUBSCRIPTION_PAYMENT_FAILED_EVENT_TYPE) {
+    return reducePaymentFailed(state, event);
+  }
+  return reduceSubscriptionResource(state, event, options);
+}
diff --git a/src/subscription-core/lib/subscription-core-types.ts b/src/subscription-core/lib/subscription-core-types.ts

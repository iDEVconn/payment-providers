{
  "name": "@idevconn/payment-providers",
  "version": "0.2.0",
  "description": "Provider-neutral payment capabilities and PayPal adapter extracted from EmployeeDrivenContent",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDEVconn/payment-providers.git"
  },
  "bugs": {
    "url": "https://github.com/iDEVconn/payment-providers/issues"
  },
  "homepage": "https://github.com/iDEVconn/payment-providers#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./paypal": {
      "import": {
        "types": "./dist/paypal.d.ts",
        "default": "./dist/paypal.js"
      },
      "require": {
        "types": "./dist/paypal.d.cts",
        "default": "./dist/paypal.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@idevconn/payment": "^1.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
